# ============ Bot ============
# Telegram bot tokeni — @BotFather dan olinadi
BOT_TOKEN=1234567890:BotFather_bergan_tokenni_shu_yerga_yozing

# Admin Telegram ID lari, vergul bilan ajratiladi. O'z ID ingizni @userinfobot dan bilib oling
ADMIN_IDS=123456789

# Aloqa uchun ko'rsatiladigan kontakt
ALOQA=@oliytafakkur_admin

# Majburiy obuna kanali (ixtiyoriy, hozircha ishlatilmaydi)
MAJBURIY_KANAL=

# ============ Ma'lumotlar bazasi ============
# Docker'siz, kompyuterda ishga tushirganda (hech narsa o'rnatish shart emas):
DATABASE_URL=sqlite+aiosqlite:///bot.db

# ============ Docker ============
# docker compose ishlatganda quyidagilar kerak.
# DATABASE_URL yuqoridagisi EMAS, compose ichidagi PostgreSQL ishlatiladi.
POSTGRES_USER=olimpiada
POSTGRES_PASSWORD=parolni-ozgartiring
POSTGRES_DB=olimpiada
